# Copier en .env et adapter
SECRET_KEY=change-me
DEBUG=true

# Base : PostgreSQL 18 via docker compose (sinon SQLite par défaut)
DB_ENGINE=postgres
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=taskflow
DB_HOST=127.0.0.1
DB_PORT=5432

# E-mail : Mailpit (docker compose) — interface http://localhost:8025
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025

# Cache Redis (optionnel) — visualisation via RedisInsight http://localhost:5540
# REDIS_URL=redis://127.0.0.1:6379/1
